# ---------------------------------------------------------------------------
# Solance — root environment template for the full Docker Compose stack.
#
# Usage:   cp .env.example .env   then edit the values below.
# The values here are SAFE PLACEHOLDERS for local development. NEVER commit a
# real `.env` (it is git-ignored). Override every secret on staging/production.
#
# Each variable below is consumed by docker-compose.yml.
# ---------------------------------------------------------------------------

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=solance
POSTGRES_PASSWORD=solance
POSTGRES_DB=solance
# Host port mapped to the container's 5432 (host-side only; for debugging).
POSTGRES_PORT=5432

# --- Backend (Rust / Axum) -------------------------------------------------
# Host + container port for the API.
BACKEND_PORT=8080
# Secret used to sign session JWTs. MUST be a long random string in production,
# e.g. generate with: openssl rand -hex 32
JWT_SECRET=dev-secret-change-in-production
# Allowed CORS origin — must equal the browser origin of the frontend below.
FRONTEND_URL=http://localhost:3000
# Backend log level (error | warn | info | debug | trace).
RUST_LOG=info
# NOTE: DATABASE_URL is assembled automatically inside docker-compose.yml from
# the POSTGRES_* values and the internal `postgres` service hostname, so it does
# not need to be set here.

# --- Frontend (Next.js) ----------------------------------------------------
# Host port mapped to the container's 3000.
FRONTEND_PORT=3000
# Public URL the BROWSER uses to reach the backend API. Inlined at build time
# (NEXT_PUBLIC_*), so changing it requires rebuilding the frontend image.
# Local: http://localhost:8080 — Staging/Prod: https://api.your-domain.com
NEXT_PUBLIC_API_URL=http://localhost:8080
# Solana JSON-RPC endpoint used by the wallet adapter (Devnet by default).
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

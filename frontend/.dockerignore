# Keep the build context small and reproducible. Dependencies are installed
# inside the image from the lockfile, and build output is generated there too.

# Installed dependencies — reinstalled via `npm ci` in the image.
node_modules/

# Next.js build output — regenerated by `npm run build`.
.next/
out/

# Local environment / secrets. NEXT_PUBLIC_* values are passed as build args,
# never copied from local env files.
.env
.env.*

# VCS / editor / OS noise.
.git
.gitignore
.vscode/
.idea/
.DS_Store

# Docker files are not needed inside the build context.
Dockerfile
.dockerignore

# Logs.
npm-debug.log*

# syntax=docker/dockerfile:1

# ---------------------------------------------------------------------------
# Solance frontend (Next.js 16 / React 19) production image.
#
# Multi-stage build that produces a minimal runtime image from Next.js'
# `output: "standalone"` bundle (see next.config.ts).
#
# IMPORTANT — `NEXT_PUBLIC_*` variables are INLINED into the client bundle at
# BUILD time, not read at runtime. They are therefore passed as build args and
# must be supplied when the image is built (docker-compose wires them via
# `build.args`). Changing them requires a rebuild.
#
# Node is pinned to 20 (bookworm-slim) to match CI and Next 16's minimum
# supported runtime.
# ---------------------------------------------------------------------------

# ---- Dependencies stage --------------------------------------------------
# Installs node_modules from the lockfile in isolation so this layer is only
# rebuilt when package.json / package-lock.json change.
FROM node:20-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
# `npm ci` performs a clean, reproducible install from the lockfile.
RUN npm ci

# ---- Builder stage -------------------------------------------------------
FROM node:20-bookworm-slim AS builder
WORKDIR /app

# Public API/RPC endpoints are compile-time constants for the browser bundle.
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SOLANA_RPC_URL
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
ENV NEXT_PUBLIC_SOLANA_RPC_URL=${NEXT_PUBLIC_SOLANA_RPC_URL}
# Production build (disables dev-only behaviour, enables optimisations).
ENV NODE_ENV=production
# Opt out of Next.js anonymous telemetry in CI/containers.
ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

# ---- Runtime stage -------------------------------------------------------
# Ships only the standalone server output — no dev dependencies, no source.
FROM node:20-bookworm-slim AS runtime
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
# The standalone server reads PORT/HOSTNAME; bind all interfaces inside the
# container so the orchestrator can route to it.
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# The base image already provides an unprivileged `node` user (uid 1000); use
# it instead of root.
USER node

# Copy the standalone server, static assets, and public files. Ownership is set
# to `node` so the non-root user can read them.
# - .next/standalone : minimal server + traced node_modules + server.js
# - .next/static     : hashed client assets (not included in standalone)
# - public           : static files served at the site root
COPY --from=builder --chown=node:node /app/.next/standalone ./
COPY --from=builder --chown=node:node /app/.next/static ./.next/static
COPY --from=builder --chown=node:node /app/public ./public

EXPOSE 3000

# `server.js` is generated by the standalone build at the bundle root.
CMD ["node", "server.js"]
